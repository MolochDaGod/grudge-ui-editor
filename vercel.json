{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/GRUDGE6_Characters",
      "destination": "/GRUDGE6_Characters.html"
    },
    {
      "source": "/GRUDGE6_Characters.html",
      "destination": "/GRUDGE6_Characters.html"
    },
    {
      "source": "/grudge6-characters",
      "destination": "/GRUDGE6_Characters.html"
    },
    {
      "source": "/api/auth/me",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/me"
    },
    {
      "source": "/api/auth/verify",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/verify"
    },
    {
      "source": "/api/auth/session/exchange",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/session/exchange"
    },
    {
      "source": "/api/auth/puter",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/puter"
    },
    {
      "source": "/api/auth/puter-sso",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/puter-sso"
    },
    {
      "source": "/api/auth/guest",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/guest"
    },
    {
      "source": "/api/auth/popup-token",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/popup-token"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/api/characters",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters/:path*"
    },
    {
      "source": "/api/account",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account"
    },
    {
      "source": "/api/account/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account/:path*"
    },
    {
      "source": "/api/ai/health",
      "destination": "https://ai.grudge-studio.com/health"
    },
    {
      "source": "/api/ai/agents",
      "destination": "https://ai.grudge-studio.com/v1/agents"
    },
    {
      "source": "/api/ai/:path*",
      "destination": "https://ai.grudge-studio.com/v1/:path*"
    },
    {
      "source": "/api/objectstore/:path*",
      "destination": "https://objectstore.grudge-studio.com/api/v1/:path*"
    },
    {
      "source": "/api/registry/:path*",
      "destination": "https://objectstore.grudge-studio.com/api/v1/:path*"
    },
    {
      "source": "/api/registry",
      "destination": "https://objectstore.grudge-studio.com/api/v1/docs-catalog.json"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://assets.grudge-studio.com/:path*"
    },
    {
      "source": "/login",
      "destination": "https://id.grudge-studio.com/login"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://id.grudge-studio.com/auth/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/hotkeys",
      "destination": "/hotkeys.html"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/games",
      "destination": "/games.html"
    },
    {
      "source": "/assets",
      "destination": "/assets.html"
    },
    {
      "source": "/main-panel",
      "destination": "/main-panel.html"
    },
    {
      "source": "/main-panel/",
      "destination": "/main-panel.html"
    },
    {
      "source": "/spellbook",
      "destination": "/spellbook.html"
    },
    {
      "source": "/spellbook/",
      "destination": "/spellbook.html"
    },
    {
      "source": "/equipment",
      "destination": "/main-panel.html?tab=equipment&era=warlords"
    },
    {
      "source": "/eras",
      "destination": "/eras/index.json"
    },
    {
      "source": "/((?!hotkeys|studio|games|assets|main-panel|spellbook|equipment|eras|favicon|grudge-shell|prim-packs|game-ui|equipment-paperdoll|systems\\.json|docs|api|auth).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/game-ui-packs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/eras/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/equipment-paperdoll.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/main-panel.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        },
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.grudge-studio.com https://*.vercel.app https://grudgewarlords.com https://*.replit.app"
        }
      ]
    },
    {
      "source": "/grudge-fonts.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/spellbook.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.grudge-studio.com https://*.vercel.app https://grudgewarlords.com https://*.replit.app"
        }
      ]
    },
    {
      "source": "/systems.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/game-ui-runtime.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/bars-hud-ssot.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/hud-settings.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.grudge-studio.com https://*.vercel.app https://grudgewarlords.com"
        }
      ]
    }
  ]
}
